# Brewfile - Homebrew Bundle Configuration
# Usage: brew bundle install
# To generate from current setup: brew bundle dump

# ============================================================================
# ESSENTIAL PACKAGES
# ============================================================================

# Version control system - absolutely essential for any development work
brew "git"

# Python programming language and package manager
brew "python"

# JavaScript runtime environment - required for web development and many tools
brew "node"

# Java runtime / SDK (also run: sudo ln -sfn /opt/homebrew/opt/openjdk/libexec/openjdk.jdk /Library/Java/JavaVirtualMachines/openjdk.jdk)
# ! Needs a Simlink
brew "openjdk"

# Modern, extensible vim editor with better defaults and plugin support
brew "neovim"

# GNU Compiler Collection - essential for compiling C/C++ code and building from source
brew "gcc"

# Scons - substitute for 'make' (Used in gem5)
brew "scons"

# Beautiful terminal UI for git operations - makes complex git workflows intuitive
brew "lazygit"

# Git history rewriting tool
brew "git-filter-repo"

# GNU debugger
brew "gdb"

# Java development kit
brew "openjdk"

# Python 3.14
brew "python@3.14"

# R language for data science
brew "r"

# Conda package manager (NOTE: needs to be added to PATH manually, already in .zshrc)
cask "miniconda"

# HazeOver dims background windows
cast "hazeover"

# ============================================================================
# SYSTEM UTILITIES & CLI ENHANCEMENTS
# ============================================================================

# Fast, user-friendly alternative to 'find' with intuitive syntax and better performance
brew "fd"

# Extremely fast grep alternative optimized for searching code repositories
brew "ripgrep"

# Displays directory structure in a tree format - great for understanding project layouts
brew "tree"

# Modern replacement for 'ls' with colors, icons, and git status integration
brew "eza"

# Non-interactive network downloader - essential for downloading files via HTTP/HTTPS
brew "wget"

# Smart 'cd' replacement that learns your navigation patterns and jumps to frequent directories
brew "zoxide"

# Symlink farm manager - perfect for managing dotfiles by creating organized symlinks
brew "stow"

# Cat clone with syntax highlighting, git integration, and automatic paging
brew "bat"

# Command-line fuzzy finder - incredibly useful for searching files, command history, etc.
brew "fzf"

# Interactive process viewer - much better than the default 'top' command
brew "htop"

# Command-line JSON processor - essential for working with APIs and JSON data
# brew "jq"

# Simplified man pages with practical examples - faster way to learn commands
brew "tealdeer"

# More intuitive disk usage analyzer - better alternative to 'du'
brew "dust"

# Modern process viewer with colored output and better information display
brew "procs"

# Terminal image viewer - display images directly in your terminal
brew "viu"

# Terminal multiplexer - run multiple terminal sessions in one window, persistent sessions
brew "tmux"

# Command-line tool for transferring data
brew "curl"

# Better git diff output
brew "diff-so-fancy"

# Download videos from YouTube and other sites
brew "yt-dlp"

# ASCII art text generator
brew "figlet"

# Tree sitter for neovim config
brew "tree-sitter-cli"

