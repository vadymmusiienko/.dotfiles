# Theme - Rose Pine
theme = "rose-pine"
selection-background = 1d3c3b
selection-foreground = eeeeee

# Window settings
window-padding-x = 10
window-padding-y = 30
window-decoration = auto
# background-opacity = 0.9
# background-blur-radius = 20
fullscreen = true
macos-non-native-fullscreen = true
window-width = 120
window-height = 45
window-theme = auto
resize-overlay = after-first

# Font configuration
font-family = "MesloLGS Nerd Font Mono"
font-style = Regular
font-size = 16
font-thicken = true
adjust-underline-position = 40%
adjust-underline-thickness = -60%
# font-feature = -liga  # Disable ligatures
font-feature = +liga


# Cursor settings
# cursor-style = block
# cursor-style-blink = false
# shell-integration-features = no-cursor
cursor-color = #ff0078

# Shell settings
shell-integration-features = cursor,sudo,title
shell-integration = detect

# Mouse settings
mouse-hide-while-typing = true

# Scrolling
scrollback-limit = 10000

# Performance optimizations (Ghostty-specific)
macos-titlebar-style = hidden

# Advanced features
quit-after-last-window-closed = true
confirm-close-surface = false

# Custom icon (glass | xray | official)
macos-icon = xray

# Keybindings
# Disable specific keybindings (to avoid ;10D)
# keybind = shift+left=ignore
# keybind = shift+right=ignore
# keybind = cmd+shift+left=ignore
# keybind = cmd+shift+right=ignore
