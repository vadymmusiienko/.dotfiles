{
    "show_whats_new": false,
    "initial_working_directory": "~/Desktop",
    "default_open_project_location": "~/Desktop",
    "graphics_backend": "ragg",
    "graphics_antialiasing": "gray",
    "num_spaces_for_tab": 4,
    "auto_detect_indentation": true,
    "relative_line_numbers": true,
    "scroll_past_end_of_document": true,
    "highlight_r_function_calls": true,
    "rainbow_parentheses": true,
    "reformat_on_save": true,
    "use_air_formatter": true,
    "auto_append_newline": true,
    "strip_trailing_whitespace": true,
    "editor_keybindings": "vim",
    "posix_terminal_shell": "zsh",
    "editor_theme": "catppuccin-mocha",
    "font_size_points": 11,
    "panes": {
        "quadrants": [
            "Source",
            "Console",
            "TabSet1",
            "TabSet2"
        ],
        "tabSet1": [
            "Build",
            "VCS",
            "Viewer",
            "Presentation"
        ],
        "tabSet2": [
            "Files",
            "Plots",
            "Packages",
            "Help",
            "Presentations"
        ],
        "hiddenTabSet": [
            "Environment",
            "History",
            "Connections",
            "Tutorial",
            "Chat"
        ],
        "console_left_on_top": false,
        "console_right_on_top": true,
        "additional_source_columns": 0,
        "sidebar": [],
        "sidebar_visible": false,
        "sidebar_location": "left"
    },
    "python_type": "system",
    "python_version": "3.9.6",
    "python_path": "/usr/bin/python3",
    "syntax_color_console": true,
    "jobs_tab_visibility": "shown"
}