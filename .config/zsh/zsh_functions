# Function to quickly search and display cheat sheets
cheat() {
    if [ "$#" -eq 0 ]; then
        curl cht.sh
    else
        curl "cht.sh/$*"
    fi
}

# Quick directory creation and navigation
mkcd() {
    mkdir -p "$1" && cd "$1"
}

