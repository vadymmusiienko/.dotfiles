# Extract any archive
extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2) tar xjf "$1" ;;
            *.tar.gz)  tar xzf "$1" ;;
            *.bz2)     bunzip2 "$1" ;;
            *.rar)     unrar x "$1" ;;
            *.gz)      gunzip "$1" ;;
            *.tar)     tar xf "$1" ;;
            *.tbz2)    tar xjf "$1" ;;
            *.tgz)     tar xzf "$1" ;;
            *.zip)     unzip "$1" ;;
            *.Z)       uncompress "$1" ;;
            *.7z)      7z x "$1" ;;
            *)         echo "'$1' cannot be extracted" ;;
        esac
    else
        echo "'$1' is not a valid file"
    fi
}

# Quick backup function
backup() {
    cp "$1"{,.bak}
}

# Find file by name
ff() {
    /usr/bin/find . -type f -name "*$1*" 2>/dev/null
}

# Find directory by name
fd() {
    /usr/bin/find . -type d -name "*$1*" 2>/dev/null
}

# Get public IP and location info
myipinfo() {
    curl -s "https://ipinfo.io" | jq .
}

# Generate random password
genpass() {
    local length=${1:-16}
    openssl rand -base64 32 | cut -c1-$length
}