# File operations (using eza) better ls replacements
alias ls="eza --icons=always"
alias ll="eza -l --icons=always --git"
alias la="eza -la --icons=always --git"
alias lt="eza --tree --icons=always"
alias l1="eza -1 --icons=always"

# Navigation (using zoxide) better cd replacements
alias cd="z"
alias cdi="zi"  # Interactive cd with zoxide
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."

